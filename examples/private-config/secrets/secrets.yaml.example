# Example only, NOT sops-encrypted. In a real private companion repo this
# would be a real sops-encrypted secrets.yaml, created with `sops
# secrets.yaml` after generating your own age keypair (see the root
# repo's docs/bootstrap.md).
#
# One file per machine that needs secrets (secrets/<machine>.yaml,
# matching machines/<machine>.nix) rather than one shared file: the same
# service can need a different token on a different machine, and
# nix-config's secrets-sops.nix is built around that -- each machine's
# user.nix points its own sopsFile at its own file.
#
# Key names are whatever you list in that machine's user.nix `secrets`
# field -- sops-nix doesn't care what they're called.
GITHUB_PERSONAL_ACCESS_TOKEN: "example-placeholder-value"
MY_SERVICE_PAT: "example-placeholder-value"
