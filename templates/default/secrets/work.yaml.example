# The shape of secrets/work.yaml, NOT sops-encrypted. Create the real file
# with `sops secrets/work.yaml` once .sops.yaml holds your key.
#
# One file per machine: the same service can need a different token on a
# different machine, so each config points its own atelier.sops.file at its
# own file, and the same key name can carry a different value per machine.
# Key names are whatever that config lists in atelier.sops.secrets.
GITHUB_PERSONAL_ACCESS_TOKEN: "example-placeholder-value"
MY_SERVICE_PAT: "example-placeholder-value"
