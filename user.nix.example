# Copy to user.nix and fill in your values before running home-manager switch.
# user.nix is gitignored and never committed — each machine has its own copy.
# sshKey is derived automatically from the personal email prefix.
{
  username = "yourusername";
  name     = "Your Name";
  email    = "you@example.com";

  # Optional: this machine's default profile name (e.g. "personal", "work",
  # "work-gui"). Lets `just switch` run with no argument on this machine.
  # See docs/profiles.md for the full list. Safe to omit — `just switch`
  # still defaults to "personal" if this key isn't set.
  # profile = "personal";

  # Optional: extra named features (see modules/features.nix) to layer onto
  # this machine's profile beyond its tier's defaults — e.g. a personal-gui
  # machine that also wants Kubernetes tooling without switching tiers.
  # extraFeatures = ["k8s"];

  # Optional: named features to drop, regardless of tier or extraFeatures.
  # Also silences the unsupported-platform warning for a feature this
  # machine was never going to use anyway.
  # excludeFeatures = ["lang-rust"];

  # Optional: absolute paths to private, machine-specific home-manager
  # modules outside this repo (e.g. a private modules repo cloned locally).
  # Requires --impure, already required for user.nix itself.
  # extraModulePaths = ["/Users/you/.config/nix-private/machines/workstation.nix"];

  # Work git identity — used by modules/work.nix to override base git config.
  # Only used by work profiles; safe to leave placeholder values if you don't use work contexts.
  work = {
    name  = "Your Work Name";
    email = "you@work.example.com";
  };

  # Optional: default AWS_PROFILE for this machine. Left unset by default —
  # this repo's cloud feature loads on both personal and work profiles, so a
  # hardcoded default risks a command silently hitting the wrong account.
  # Only set this if one profile name is genuinely always correct here.
  # aws = { profile = "default"; };

  # Optional: private Kiro CLI config repo, cloned to ~/.kiro on work
  # profiles. Not a submodule of this repo (it's private, work-specific
  # content) — kept here so the URL never touches this public repo.
  # kiroRepo = "git@github.com:youruser/your-private-kiro-config.git";

  # Optional: use sops-nix (secrets/secrets.yaml) instead of manually
  # copying secrets.env.example to ~/.config/secrets/env. Off by default —
  # requires your own age keypair (see .sops.yaml for the recipient this
  # repo's secrets/secrets.yaml is currently encrypted for) with the private
  # half placed manually at ~/.config/sops/age/keys.txt (see
  # modules/secrets-sops.nix and docs/bootstrap.md for the exact steps).
  # useSops = true;

  # Optional: private remote overrides for config/ submodules.
  # For each key matching a submodule name, home-manager activation will add a
  # "private" remote and check out a tracking branch automatically.
  # Leave empty or omit entirely to use the default public submodule remotes.
  # Activation is idempotent — safe to rerun. If the first run skipped the fetch
  # because your SSH key wasn't added yet, rerun `home-manager switch --impure` after
  # adding the key to GitHub.
  submodules = {
    # claude   = "git@github.com:youruser/your-private-claude-config.git";
    # gitalias = "git@github.com:youruser/gitalias.git";  # personal fork override
  };
}
